// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model User {
  id               String    @id @default(uuid())
  role             String    @default("USER") // SSO or USER
  fullName         String    @map("full_name")
  email            String
  passwordHash     String    @map("password_hash")
  isActive         Boolean   @default(true) @map("is_active")
  homeLat          Float     @map("home_lat")
  homeLng          Float     @map("home_lng")
  homePoint        Unsupported("geography(Point, 4326)")? @map("home_point")
  kelurahan        String?
  kecamatan        String?
  kota             String?
  provinsi         String?
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  createdEvents    DisasterEvent[]
  notifications    UserNotification[]
  auditLogs        AuditLog[]

  @@unique([email, deletedAt])
  @@index([kelurahan])
  @@index([role, isActive])
  @@map("users")
}

model DisasterCategory {
  id          String    @id @default(uuid())
  code        String
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  events      DisasterEvent[]

  @@unique([code, deletedAt])
  @@index([isActive])
  @@map("disaster_categories")
}

model DisasterEvent {
  id              String    @id @default(uuid())
  categoryId      String    @map("category_id")
  title           String
  description     String    @db.Text
  eventTime       DateTime  @map("event_time") @db.Timestamptz
  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  status          String    @default("DRAFT") // DRAFT, PUBLISHED, CANCELLED
  locationLat     Float     @map("location_lat")
  locationLng     Float     @map("location_lng")
  locationPoint   Unsupported("geography(Point, 4326)")? @map("location_point")
  kelurahan       String?
  kecamatan       String?
  kota            String?
  dangerRadiusM   Int       @default(2000) @map("danger_radius_m")
  warningRadiusM  Int       @default(10000) @map("warning_radius_m")
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  category        DisasterCategory @relation(fields: [categoryId], references: [id])
  creator         User             @relation(fields: [createdBy], references: [id])
  notifications   UserNotification[]

  @@index([categoryId])
  @@index([status])
  @@index([eventTime])
  @@index([kelurahan])
  @@map("disaster_events")
}

model UserNotification {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  eventId       String    @map("event_id")
  priority      String // DANGER or WARNING
  distanceM     Int       @map("distance_m")
  channel       String    @default("IN_APP") // IN_APP, EMAIL
  emailStatus   String    @default("PENDING") @map("email_status") // PENDING, SENT, SKIPPED_NO_SSL, SKIPPED_CONFIG, FAILED
  emailSentAt   DateTime? @map("email_sent_at") @db.Timestamptz
  readAt        DateTime? @map("read_at") @db.Timestamptz
  errorMessage  String?   @map("error_message") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  user          User          @relation(fields: [userId], references: [id])
  event         DisasterEvent @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId, deletedAt])
  @@index([userId, readAt])
  @@index([eventId])
  @@map("user_notifications")
}

model AuditLog {
  id         String    @id @default(uuid())
  actorId    String?   @map("actor_id")
  action     String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id")
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  actor      User?     @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
